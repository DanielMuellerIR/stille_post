    <key>NSLocalNetworkUsageDescription</key><string>Stille Post sends your recording to the Mac you configure on your home network.</string>
    <key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
    <key>ITSAppUsesNonExemptEncryption</key><false/>
